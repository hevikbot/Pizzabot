LOCATIONS = [
    {"city": "Київ", "address": "вул. Хрещатик, 22", "phone": "+380 44 123 45 67", "hours": "10:00–22:00"},
    {"city": "Львів", "address": "просп. Свободи, 15", "phone": "+380 32 234 56 78", "hours": "10:00–22:00"},
