]

# ==========================================================
#  СОСТОЯНИЯ (FSM) — для корзины и поддержки
# ==========================================================

class SupportState(StatesGroup):
    waiting_for_message = State()

# храним корзину пользователя в памяти: {user_id: {item_key: qty}}
carts: dict[int, dict[str, int]] = {}

# ==========================================================
#  КЛАВИАТУРЫ
# ==========================================================

def main_menu_kb() -> InlineKeyboardMarkup:
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="🍕 Меню", callback_data="menu")],
        [InlineKeyboardButton(text="🛒 Корзина", callback_data="cart")],
        [InlineKeyboardButton(text="📍 Наші ресторани", callback_data="locations")],
        [InlineKeyboardButton(text="🆘 Підтримка", callback_data="support")],
    ])

def menu_kb() -> InlineKeyboardMarkup:
    buttons = []
    for key, item in MENU.items():
        buttons.append([InlineKeyboardButton(
            text=f"{item['name']} — {item['price']} грн",
            callback_data=f"item_{key}"
        )])
    buttons.append([InlineKeyboardButton(text="⬅️ Назад", callback_data="back_main")])
    return InlineKeyboardMarkup(inline_keyboard=buttons)

def item_kb(key: str) -> InlineKeyboardMarkup:
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="➕ Додати в кошик", callback_data=f"add_{key}")],
        [InlineKeyboardButton(text="⬅️ До меню", callback_data="menu")],
    ])

def cart_kb(has_items: bool) -> InlineKeyboardMarkup:
    buttons = []
    if has_items:
        buttons.append([InlineKeyboardButton(text="✅ Оформити замовлення", callback_data="checkout")])
        buttons.append([InlineKeyboardButton(text="🗑 Очистити кошик", callback_data="clear_cart")])
    buttons.append([InlineKeyboardButton(text="⬅️ Назад", callback_data="back_main")])
    return InlineKeyboardMarkup(inline_keyboard=buttons)

def back_kb() -> InlineKeyboardMarkup:
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="⬅️ Назад", callback_data="back_main")]
    ])

# ==========================================================
#  ОБРАБОТЧИКИ: СТАРТ / ГЛАВНОЕ МЕНЮ
# ==========================================================

@router.message(CommandStart())
async def cmd_start(message: Message):
    await message.answer(
        "Привіт! 🍕 Ласкаво просимо в <b>Pizza Bot</b>!\n"
        "Обирай розділ нижче:",
        reply_markup=main_menu_kb(),
        parse_mode="HTML",
    )

@router.callback_query(F.data == "back_main")
async def back_main(callback: CallbackQuery):
    await callback.message.edit_text(
        "Головне меню. Обирай розділ:",
        reply_markup=main_menu_kb(),
    )
    await callback.answer()

# ==========================================================
#  МЕНЮ ПИЦЦЫ
# ==========================================================

@router.callback_query(F.data == "menu")
async def show_menu(callback: CallbackQuery):
    await callback.message.edit_text(
        "🍕 <b>Наше меню</b>\nОбери піцу, щоб побачити опис:",
        reply_markup=menu_kb(),
        parse_mode="HTML",
    )
    await callback.answer()

@router.callback_query(F.data.startswith("item_"))
async def show_item(callback: CallbackQuery):
    key = callback.data.replace("item_", "")
    item = MENU[key]
    text = f"<b>{item['name']}</b>\n{item['desc']}\n\nЦіна: <b>{item['price']} грн</b>"
    await callback.message.edit_text(text, reply_markup=item_kb(key), parse_mode="HTML")
    await callback.answer()

@router.callback_query(F.data.startswith("add_"))
async def add_to_cart(callback: CallbackQuery):
    key = callback.data.replace("add_", "")
    user_id = callback.from_user.id
    carts.setdefault(user_id, {})
    carts[user_id][key] = carts[user_id].get(key, 0) + 1
    await callback.answer(f"Додано: {MENU[key]['name']} ✅")

# ==========================================================
#  КОРЗИНА
# ==========================================================

def format_cart(user_id: int) -> tuple[str, bool]:
    cart = carts.get(user_id, {})
    if not cart:
        return "🛒 Кошик порожній.", False
    lines = ["🛒 <b>Ваш кошик:</b>\n"]
    total = 0
    for key, qty in cart.items():
        item = MENU[key]
        subtotal = item["price"] * qty
        total += subtotal
        lines.append(f"{item['name']} x{qty} — {subtotal} грн")
    lines.append(f"\n<b>Разом: {total} грн</b>")
    return "\n".join(lines), True

@router.callback_query(F.data == "cart")
async def show_cart(callback: CallbackQuery):
    text, has_items = format_cart(callback.from_user.id)
    await callback.message.edit_text(text, reply_markup=cart_kb(has_items), parse_mode="HTML")
    await callback.answer()

@router.callback_query(F.data == "clear_cart")
async def clear_cart(callback: CallbackQuery):
    carts.pop(callback.from_user.id, None)
    await callback.answer("Кошик очищено 🗑")
    text, has_items = format_cart(callback.from_user.id)
    await callback.message.edit_text(text, reply_markup=cart_kb(has_items), parse_mode="HTML")

@router.callback_query(F.data == "checkout")
async def checkout(callback: CallbackQuery):
    user_id = callback.from_user.id
    text, has_items = format_cart(user_id)
    if not has_items:
        await callback.answer("Кошик порожній")
        return
    order_info = (
        f"🆕 <b>Нове замовлення!</b>\n"
        f"Від: @{callback.from_user.username or callback.from_user.id}\n\n"
        f"{text}"
    )
    try:
        await bot.send_message(ADMIN_CHAT_ID, order_info, parse_mode="HTML")
    except Exception as e:
        logging.warning(f"Не вдалося надіслати замовлення адміну: {e}")

    carts.pop(user_id, None)
    await callback.message.edit_text(
        "✅ Замовлення оформлено! Наш менеджер незабаром зв'яжеться з вами для підтвердження.",
        reply_markup=back_kb(),
    )
    await callback.answer()

# ==========================================================
#  РЕСТОРАНЫ / ЛОКАЦИИ
# ==========================================================

@router.callback_query(F.data == "locations")
async def show_locations(callback: CallbackQuery):
    lines = ["📍 <b>Наші ресторани в Україні:</b>\n"]
    for loc in LOCATIONS:
        lines.append(
            f"🏙 <b>{loc['city']}</b>\n"
            f"Адреса: {loc['address']}\n"
            f"Телефон: {loc['phone']}\n"
            f"Графік: {loc['hours']}\n"
        )
    await callback.message.edit_text("\n".join(lines), reply_markup=back_kb(), parse_mode="HTML")
    await callback.answer()

# ==========================================================
#  ПОДДЕРЖКА
# ==========================================================

@router.callback_query(F.data == "support")
async def support_start(callback: CallbackQuery, state: FSMContext):
    await callback.message.edit_text(
        "🆘 <b>Підтримка</b>\n\n"
        "Опишіть, будь ласка, ваше питання одним повідомленням — "
        "і ми передамо його оператору. Для скасування напишіть /cancel.",
        reply_markup=back_kb(),
        parse_mode="HTML",
    )
    await state.set_state(SupportState.waiting_for_message)
    await callback.answer()

@router.message(Command("cancel"))
async def cancel_support(message: Message, state: FSMContext):
    await state.clear()
    await message.answer("Скасовано.", reply_markup=main_menu_kb())

@router.message(SupportState.waiting_for_message)
async def support_message(message: Message, state: FSMContext):
    try:
        await bot.send_message(
            ADMIN_CHAT_ID,
            f"🆘 Питання від @{message.from_user.username or message.from_user.id}:\n\n{message.text}",
        )
    except Exception as e:
        logging.warning(f"Не вдалося переслати повідомлення в підтримку: {e}")

    await state.clear()
    await message.answer(
        "Дякуємо! Ваше повідомлення передано оператору. Ми відповімо найближчим часом.",
        reply_markup=main_menu_kb(),
    )

# ==========================================================
#  ЗАПУСК
# ==========================================================

async def main():
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
